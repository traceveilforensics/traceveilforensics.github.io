# Environment Variables for Netlify
# Add these in Netlify Dashboard > Site Configuration > Environment Variables

# Supabase Configuration
SUPABASE_URL=https://ehseucihglidozvlgdpt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key-here>

# JWT Secrets - Generate secure random strings (at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=<generate-with-openssl-rand-base64-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-32>

# EmailJS (optional)
EMAILJS_SERVICE_ID=<your-service-id>
EMAILJS_PUBLIC_KEY=<your-public-key>

# Make.com Webhooks (optional)
MAKE_WEBHOOK_NEW_CUSTOMER=<webhook-url>
MAKE_WEBHOOK_NEW_REQUEST=<webhook-url>
MAKE_WEBHOOK_NEW_REVIEW=<webhook-url>
